# ===================================================================
# CẤU HÌNH KẾT NỐI SUPABASE & CLOUDINARY CHO XƯỞNG BÀN GHẾ
# ===================================================================

# 1. Supabase (Cơ sở dữ liệu PostgreSQL & Auth)
# Lấy tại: https://supabase.com -> Chọn Project -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Cloudinary (Lưu trữ và tối ưu hóa hình ảnh sản phẩm / mẫu khách gửi)
# Lấy tại: https://cloudinary.com -> Dashboard
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
# Tạo Unsigned Upload Preset tại: Settings -> Upload -> Upload presets -> Add new -> Signing Mode: Unsigned
VITE_CLOUDINARY_UPLOAD_PRESET=xuongbanghe_preset

# 3. Thông tin xưởng bàn ghế hiển thị mặc định
VITE_WORKSHOP_NAME=Xưởng Bàn Ghế DIEY WOOD
VITE_WORKSHOP_PHONE=0987.654.321
VITE_WORKSHOP_ZALO=0987.654.321
VITE_WORKSHOP_ADDRESS=Km 18, Làng Nghề Mộc Canh Nậu - Thạch Thất, Hà Nội
